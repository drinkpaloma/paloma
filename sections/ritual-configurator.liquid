{% doc %}
  Static visual shell for the Ritual subscription builder (coffee / bag
  count / frequency / price). No selling plans exist in this store yet
  (Recharge is installed but not yet configured with products or a
  subscription program), so the option chips and Subscribe button don't
  add to cart -- but the chips ARE genuinely interactive (click + keyboard)
  so the picker itself feels real. Once real products + Recharge selling
  plans exist, this section should be replaced with one driven by
  product.selling_plan_groups.
{% enddoc %}

<div class="ritual-configurator section-{{ section.id }}-padding" {{ section.shopify_attributes }}>
  <div class="ritual-configurator__panel">
    <div class="ritual-configurator__group">
      <p class="ritual-configurator__step" id="ritual-step-1-{{ section.id }}">01&nbsp;&nbsp;{{ section.settings.step_1_label }}</p>
      <div class="ritual-configurator__chips" role="group" aria-labelledby="ritual-step-1-{{ section.id }}">
        {% assign coffee_options = section.settings.coffee_options | newline_to_br | strip_newlines | split: '<br />' %}
        {% for option in coffee_options %}
          <button type="button" class="ritual-configurator__chip" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{{ option | strip }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="ritual-configurator__group">
      <p class="ritual-configurator__step" id="ritual-step-2-{{ section.id }}">02&nbsp;&nbsp;{{ section.settings.step_2_label }}</p>
      <div class="ritual-configurator__chips" role="group" aria-labelledby="ritual-step-2-{{ section.id }}">
        {% assign bag_options = section.settings.bag_options | newline_to_br | strip_newlines | split: '<br />' %}
        {% for option in bag_options %}
          <button type="button" class="ritual-configurator__chip" aria-pressed="{% if forloop.index == section.settings.active_bag_index %}true{% else %}false{% endif %}">{{ option | strip }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="ritual-configurator__group">
      <p class="ritual-configurator__step" id="ritual-step-3-{{ section.id }}">03&nbsp;&nbsp;{{ section.settings.step_3_label }}</p>
      <div class="ritual-configurator__chips" role="group" aria-labelledby="ritual-step-3-{{ section.id }}">
        {% assign frequency_options = section.settings.frequency_options | newline_to_br | strip_newlines | split: '<br />' %}
        {% for option in frequency_options %}
          <button type="button" class="ritual-configurator__chip" aria-pressed="{% if forloop.index == section.settings.active_frequency_index %}true{% else %}false{% endif %}">{{ option | strip }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="ritual-configurator__summary">
      <div class="ritual-configurator__price">
        <span class="ritual-configurator__price-amount">{{ section.settings.price }}</span>
        <span class="ritual-configurator__price-unit">/ {{ section.settings.price_unit }}</span>
      </div>
      <button type="button" class="button ritual-configurator__subscribe" disabled title="{{ 'Connect a subscription product to enable this' }}">
        {{ section.settings.button_label }}
      </button>
    </div>
    <p class="ritual-configurator__note">{{ section.settings.note }}</p>
  </div>

  <div class="ritual-configurator__media">
    {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw' }}
  </div>
</div>

{% # Click-to-select within each option group; real <button> elements already get %}
{% # keyboard activation (Tab + Enter/Space) for free, so no key handling needed here. %}
<script>
  document.querySelectorAll('.ritual-configurator__chips').forEach(function (group) {
    group.addEventListener('click', function (event) {
      var chip = event.target.closest('.ritual-configurator__chip');
      if (!chip) return;
      group.querySelectorAll('.ritual-configurator__chip').forEach(function (c) {
        c.setAttribute('aria-pressed', c === chip ? 'true' : 'false');
      });
    });
  });
</script>

{% stylesheet %}
  .ritual-configurator {
    display: grid;
    grid-template-columns: 1fr;
    background: {{ settings.color_palette.background }};

    @media screen and (min-width: 750px) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .ritual-configurator__panel {
    padding: 48px 32px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .ritual-configurator__step {
    font-family: var(--font-subheading--family, ui-monospace, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: {{ settings.color_palette.color4 }};
    margin: 0 0 12px;
  }

  .ritual-configurator__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* border-width stays constant across states -- only color/background
     change -- so selecting a chip never shifts layout by a pixel. */
  .ritual-configurator__chip {
    display: inline-flex;
    align-items: center;
    padding: 14px 20px;
    border: 2px solid {{ settings.color_palette.color2 }};
    background: transparent;
    color: {{ settings.color_palette.foreground }};
    font-family: inherit;
    font-size: 1rem;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .ritual-configurator__chip:hover {
    border-color: {{ settings.color_palette.color1 }};
  }

  .ritual-configurator__chip:focus-visible {
    outline: 2px solid {{ settings.color_palette.color1 }};
    outline-offset: 2px;
  }

  /* Selection is never color-only: border color, a faint fill, and a
     checkmark all change together. */
  .ritual-configurator__chip[aria-pressed='true'] {
    border-color: {{ settings.color_palette.foreground }};
    background: {{ settings.color_palette.color2 }}4d;
  }

  .ritual-configurator__chip[aria-pressed='true']::after {
    content: '✓';
    margin-left: 8px;
    font-size: 0.85em;
  }

  .ritual-configurator__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 16px;
    border-top: 1px solid {{ settings.color_palette.color2 }};
  }

  .ritual-configurator__price {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .ritual-configurator__price-amount {
    font-family: var(--font-heading--family);
    font-size: 2.25rem;
  }

  .ritual-configurator__price-unit {
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: 1rem;
    color: {{ settings.color_palette.color4 }};
  }

  .ritual-configurator__subscribe {
    background: {{ settings.color_palette.foreground }};
    color: {{ settings.color_palette.background }};
    border: none;
    padding: 16px 28px;
    font-family: var(--font-subheading--family, ui-monospace, monospace);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: not-allowed;
    opacity: 0.55;
  }

  .ritual-configurator__note {
    font-family: var(--font-subheading--family, ui-monospace, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: {{ settings.color_palette.color4 }};
    margin: 0;
  }

  .ritual-configurator__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ritual configurator",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Visual placeholder only — chips and Subscribe are not wired to a real product or selling plan. Rebuild once real products and a Recharge subscription program exist."
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "step_1_label", "label": "Step 1 label", "default": "Choose your coffee" },
    { "type": "textarea", "id": "coffee_options", "label": "Coffee options (one per line)", "default": "Dawn house blend\nRotating single origin\nDusk (decaf)\nRoaster's choice" },
    { "type": "text", "id": "step_2_label", "label": "Step 2 label", "default": "How much" },
    { "type": "textarea", "id": "bag_options", "label": "Bag options (one per line)", "default": "1 bag\n2 bags\n4 bags" },
    { "type": "range", "id": "active_bag_index", "label": "Highlighted bag option", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "text", "id": "step_3_label", "label": "Step 3 label", "default": "How often" },
    { "type": "textarea", "id": "frequency_options", "label": "Frequency options (one per line)", "default": "Weekly\nEvery 2 weeks\nMonthly" },
    { "type": "range", "id": "active_frequency_index", "label": "Highlighted frequency option", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "text", "id": "price", "label": "Price", "default": "$39.60" },
    { "type": "text", "id": "price_unit", "label": "Price unit", "default": "shipment" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "note", "label": "Note", "default": "10% off · Free shipping · Pause anytime" }
  ],
  "presets": [{ "name": "Ritual configurator" }]
}
{% endschema %}
