

{% doc %}
  Color dot in its own bordered cell (a faint left rule completes the
  square against the wares_spotlight box's own top/right/bottom borders).
  A plain <span class="..."> can't be entered through a richtext "text"
  setting (Shopify's sanitizer strips class/style attributes there), so
  this renders as raw block markup instead.
{% enddoc %}

<span class="wares-swatch-cell" {{ block.shopify_attributes }}>
  <span class="wares-swatch-dot"></span>
</span>

{% stylesheet %}
  .wares-swatch-cell {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    padding-inline: 20px;
    margin-block: -16px;
    border-left: 1px solid {{ settings.color_palette.color1 }};
  }

  .wares-swatch-dot {
    display: inline-block;
    width: 20px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: {{ settings.color_palette.color1 }};
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Swatch dot",
  "tag": null
}
{% endschema %}
