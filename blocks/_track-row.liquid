

{% liquid
  assign index = block.settings.index
  assign title = block.settings.title
  assign subtitle = block.settings.subtitle
  assign duration = block.settings.duration
%}

<div class="track-row" {{ block.shopify_attributes }}>
  <span class="track-row__index">({{ index }})</span>
  <span class="track-row__title">{{ title }}</span>
  <span class="track-row__subtitle">{{ subtitle }}</span>
  <span class="track-row__duration">{{ duration }}</span>
</div>

{% stylesheet %}
  .track-row {
    display: grid;
    grid-template-columns: 60px 1fr auto auto;
    align-items: baseline;
    gap: 24px;
    padding-block: 20px;
    padding-inline: var(--page-margin, 24px);
    border-bottom: 1px solid #5240312e;
    transition: background-color 0.15s ease;
  }

  .track-row:first-child {
    border-top: 1px solid #5240312e;
  }

  .track-row:hover {
    background-color: #B5BCCD;
  }

  .track-row__index {
    font-family: var(--font-subheading--family, ui-monospace, monospace);
    font-size: 0.8rem;
    color: #7f6934;
    transition: color 0.15s ease;
  }

  .track-row__title {
    font-family: var(--font-heading--family);
    font-size: 1.75rem;
    color: #524031;
    transition: color 0.15s ease;
  }

  .track-row__subtitle {
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: 1rem;
    color: #7f6934;
    justify-self: end;
    transition: color 0.15s ease;
  }

  .track-row__duration {
    font-family: var(--font-subheading--family, ui-monospace, monospace);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    color: #524031;
    justify-self: end;
    transition: color 0.15s ease;
  }

  .track-row:hover .track-row__index,
  .track-row:hover .track-row__title,
  .track-row:hover .track-row__subtitle,
  .track-row:hover .track-row__duration {
    color: #F4F1E7;
  }

  @media screen and (max-width: 749px) {
    .track-row {
      grid-template-columns: 40px 1fr;
      row-gap: 4px;
    }

    .track-row__subtitle,
    .track-row__duration {
      justify-self: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Track row",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "index",
      "label": "Number",
      "default": "01"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Morning, unhurried"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Pairing",
      "default": "drink with Dawn"
    },
    {
      "type": "text",
      "id": "duration",
      "label": "Duration",
      "default": "48 MIN"
    }
  ]
}
{% endschema %}
